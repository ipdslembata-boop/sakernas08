<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tracking Assignment Petugas - SE2026 BPS Lembata</title>
    <!-- Tailwind CSS untuk Desain Modern -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Alpine.js untuk Interaktivitas Ringan -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-50 font-sans text-slate-800" x-data="dashboardData()">

    <!-- Header / Navbar -->
    <header class="bg-indigo-900 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center">
            <div>
                <h1 class="text-xl font-bold tracking-wide">MONITORING ASSIGNMENT PETUGAS</h1>
                <p class="text-xs text-indigo-200 mt-0.5">Sensus Ekonomi 2026 (SE2026) — BPS Kabupaten Lembata</p>
            </div>
            <div class="mt-3 md:mt-0 flex items-center space-x-2">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-800 text-emerald-100">
                    <span class="w-2 h-2 mr-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
                    Live Data: data_petugas_bersih.json
                </span>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">

        <!-- Pesan Loading / Error -->
        <template x-if="loading">
            <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-6 rounded-xl text-center">
                <p class="text-sm font-medium animate-pulse">Memuat data penugasan petugas dari GitHub...</p>
            </div>
        </template>

        <template x-if="errorMessage">
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-4 rounded-xl text-center">
                <p class="text-sm font-semibold" x-text="errorMessage"></p>
                <p class="text-xs mt-1 text-red-500">Pastikan file `data_petugas_bersih.json` sudah di-upload ke repository GitHub Pages Anda.</p>
            </div>
        </template>

        <!-- Konten Utama (Muncul Setelah Data Dimuat) -->
        <template x-if="!loading && !errorMessage">
            <div class="space-y-6">
                
                <!-- Statistik Ringkasan (Cards) -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Petugas</p>
                            <h3 class="text-2xl font-bold text-slate-900 mt-1" x-text="totalPetugas"></h3>
                        </div>
                        <div class="p-3 bg-indigo-50 text-indigo-600 rounded-lg">
                            👥
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Dokumen / Assignment</p>
                            <h3 class="text-2xl font-bold text-blue-600 mt-1" x-text="totalAssignment"></h3>
                        </div>
                        <div class="p-3 bg-blue-50 text-blue-600 rounded-lg">
                            📊
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Petugas Aktif Ber-SLS</p>
                            <h3 class="text-2xl font-bold text-emerald-600 mt-1" x-text="petugasAktif"></h3>
                        </div>
                        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-lg">
                            📍
                        </div>
                    </div>
                </div>

                <!-- Bagian Tabel & Filter -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    
                    <!-- Search Bar Header -->
                    <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-3">
                        <h2 class="text-sm font-bold text-slate-700">Daftar Alokasi Tugas & SLS Petugas</h2>
                        <div class="w-full sm:w-72">
                            <input type="text" x-model="search" placeholder="Cari email atau kode SLS..." 
                                class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                    </div>

                    <!-- Tabel Data -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead>
                                <tr class="bg-slate-50 text-slate-600 border-b border-slate-200 text-xs uppercase tracking-wider">
                                    <th class="py-3 px-4 font-semibold">No</th>
                                    <th class="py-3 px-4 font-semibold">Email Petugas</th>
                                    <th class="py-3 px-4 font-semibold text-center">Total Assignment</th>
                                    <th class="py-3 px-4 font-semibold">Daftar SLS Ter-assign</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <template x-for="(item, index) in filteredData" :key="index">
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-3 px-4 text-slate-500" x-text="index + 1"></td>
                                        <td class="py-3 px-4 font-medium text-slate-900" x-text="item.email"></td>
                                        <td class="py-3 px-4 text-center">
                                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold"
                                                :class="item.total_assignment !== '0' ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-500'"
                                                x-text="item.total_assignment">
                                            </span>
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="flex flex-wrap gap-1">
                                                <template x-for="slsCode in item.sls">
                                                    <span class="bg-slate-100 text-slate-700 border border-slate-200 text-xs px-2 py-0.5 rounded font-mono" x-text="slsCode"></span>
                                                </template>
                                            </div>
                                        </td>
                                    </tr>
                                </template>

                                <!-- Jika Data Kosong / Tidak Ditemukan -->
                                <template x-if="filteredData.length === 0">
                                    <tr>
                                        <td colspan="4" class="py-8 text-center text-slate-400">
                                            Tidak ada data petugas yang cocok dengan kata kunci pencarian.
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </template>

    </main>

    <!-- Footer -->
    <footer class="text-center py-6 text-xs text-slate-400">
        &copy; 2026 BPS Kabupaten Lembata — Dibuat untuk Monitoring SE2026.
    </footer>

    <!-- Logika JavaScript (Alpine.js) -->
    <script>
        function dashboardData() {
            return {
                petugasList: [],
                loading: true,
                errorMessage: '',
                search: '',

                init() {
                    // Mengambil file JSON dari direktori yang sama di GitHub Pages
                    fetch('data_petugas_bersih.json')
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('File data_petugas_bersih.json tidak ditemukan di repository.');
                            }
                            return response.json();
                        })
                        .then(data => {
                            this.petugasList = data;
                            this.loading = false;
                        })
                        .catch(error => {
                            this.errorMessage = error.message;
                            this.loading = false;
                        });
                },

                get totalPetugas() {
                    return this.petugasList.length;
                },

                get totalAssignment() {
                    return this.petugasList.reduce((sum, item) => {
                        let val = parseInt(item.total_assignment);
                        return sum + (isNaN(val) ? 0 : val);
                    }, 0);
                },

                get petugasAktif() {
                    return this.petugasList.filter(item => item.sls && item.sls.length > 0 && item.sls[0] !== "Tidak ada SLS spesifik").length;
                },

                get filteredData() {
                    if (!this.search) return this.petugasList;
                    let keyword = this.search.toLowerCase();
                    return this.petugasList.filter(item => {
                        let matchEmail = item.email.toLowerCase().includes(keyword);
                        let matchSls = item.sls.some(s => s.toLowerCase().includes(keyword));
                        return matchEmail || matchSls;
                    });
                }
            }
        }
    </script>
</body>
</html>
